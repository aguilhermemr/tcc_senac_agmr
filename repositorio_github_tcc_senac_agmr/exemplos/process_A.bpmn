<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ProcessA"
                  targetNamespace="http://senac.angelia/bpmn"
                  exporter="manual" exporterVersion="1.0">
  <bpmn:process id="Process_SelecaoPessoal" name="Selecao de Pessoal" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Vaga aberta">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Triagem" name="Triagem de curriculos">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="duration" value="180"/>
          <zeebe:property name="cost" value="10"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Apto" name="Apto?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Rejected" name="Rejeitado">
      <bpmn:incoming>Flow_3b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_EntrevistaTecnica" name="Entrevista tecnica">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="duration" value="3600"/>
          <zeebe:property name="cost" value="100"/>
          <zeebe:property name="critical" value="true"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Tec" name="Aprovado tecnico?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5a</bpmn:outgoing>
      <bpmn:outgoing>Flow_5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_FailedTec" name="Reprovado tecnico">
      <bpmn:incoming>Flow_5b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_EntrevistaComp" name="Entrevista comportamental">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="duration" value="2400"/>
          <zeebe:property name="cost" value="80"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5a</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AvaliacaoCultural" name="Avaliacao cultural">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="duration" value="1800"/>
          <zeebe:property name="cost" value="60"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Final" name="Contratar?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8a</bpmn:outgoing>
      <bpmn:outgoing>Flow_8b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Oferta" name="Enviar oferta">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="duration" value="600"/>
          <zeebe:property name="cost" value="30"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8a</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Hired" name="Contratado">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_NotHired" name="Nao contratado">
      <bpmn:incoming>Flow_8b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Triagem"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Triagem" targetRef="Gateway_Apto"/>

    <bpmn:sequenceFlow id="Flow_3a" sourceRef="Gateway_Apto" targetRef="Task_EntrevistaTecnica">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.6"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="Gateway_Apto" targetRef="EndEvent_Rejected">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.4"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EntrevistaTecnica" targetRef="Gateway_Tec"/>

    <bpmn:sequenceFlow id="Flow_5a" sourceRef="Gateway_Tec" targetRef="Task_EntrevistaComp">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.7"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5b" sourceRef="Gateway_Tec" targetRef="EndEvent_FailedTec">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.3"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_EntrevistaComp" targetRef="Task_AvaliacaoCultural"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AvaliacaoCultural" targetRef="Gateway_Final"/>

    <bpmn:sequenceFlow id="Flow_8a" sourceRef="Gateway_Final" targetRef="Task_Oferta">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.8"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8b" sourceRef="Gateway_Final" targetRef="EndEvent_NotHired">
      <bpmn:extensionElements>
        <zeebe:properties><zeebe:property name="probability" value="0.2"/></zeebe:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Oferta" targetRef="EndEvent_Hired"/>
  </bpmn:process>
</bpmn:definitions>
